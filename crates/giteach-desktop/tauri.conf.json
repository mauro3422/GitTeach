{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitTeach",
  "version": "0.1.0",
  "identifier": "dev.gitteach.desktop",
  "build": {
    "frontendDist": "../../src/core/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitTeach",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
